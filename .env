MODEL=./vtt_models/ggml-large-v3.bin
VTT_INPUT_GAIN=0.5
VTT_CREST_FACTOR_MAX=8
VTT_NOISE_GATE=0
VTT_MIN_SPEECH_MS=300
VTT_SILENCE_MULT=8

# MIDI mute/language toggle (Linux only). Pressing VTT_MIDI_NOTE toggles
# dictation, exactly like the Mute button; pressing VTT_MIDI_LANG_NOTE toggles
# language, exactly like the EN/ES button.
VTT_MIDI_TOGGLE=1
# Card name fragment (matched against /proc/asound/cards) or an absolute
# rawmidi path. "mk3" resolves to the Arturia MicroLab. Leave empty to
# autodetect the first MIDI device.
VTT_MIDI_DEVICE=mk3
# If your notes are on another octave, set VTT_MIDI_DEBUG=1, press the key,
# and read the note number from the log.
VTT_MIDI_NOTE=48
# 60 = middle C (Do central) toggles language. Leave unset to disable.
VTT_MIDI_LANG_NOTE=60
#VTT_MIDI_CHANNEL=0
#VTT_MIDI_DEBOUNCE_MS=250
#VTT_MIDI_DEBUG=1
